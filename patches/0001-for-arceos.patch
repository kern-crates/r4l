index 86da2ef..525917c 100644
--- a/modules/axhal/Cargo.toml
+++ b/modules/axhal/Cargo.toml
@@ -31,7 +31,7 @@ int_ratio = "0.1"
 lazyinit = "0.2"
 percpu = "0.1"
 memory_addr = "0.3"
-handler_table = "0.1"
+handler_table = { path = "../../crates/handler_table/" }
 page_table_entry = "0.4"
 page_table_multiarch = { version = "0.4", optional = true }
 axlog = { workspace = true }
